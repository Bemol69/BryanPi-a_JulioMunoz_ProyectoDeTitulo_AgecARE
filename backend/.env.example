# Copia a .env y ajusta (en Vercel se definen como Environment Variables)
# Local (Docker): postgresql+asyncpg://agecare:agecare@localhost:5432/agecare_admin
# Supabase: pega la cadena tal cual (postgresql://...). Usa el "Transaction pooler" (puerto 6543) en Vercel.
ADMIN_DATABASE_URL=postgresql+asyncpg://agecare:agecare@localhost:5432/agecare_admin
ADMIN_JWT_SECRET=cambia-esto-en-produccion
ADMIN_ENVIRONMENT=dev
ADMIN_ALLOWED_EMAIL_DOMAINS=wellq.co.uk,wellq.co
# Clave compartida con backend-general (mismo valor en ambos)
ADMIN_INTERNAL_SYNC_KEY=clave-interna-solo-para-desarrollo
# Dominios de los frontends permitidos por CORS, separados por coma (p. ej. https://agecare-consola.vercel.app)
CORS_ORIGINS=
