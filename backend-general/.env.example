# Copia a .env y ajusta (en Vercel se definen como Environment Variables)
# Local (Docker): postgresql+asyncpg://agecare:agecare@localhost:5433/agecare_general
# Supabase: pega la cadena tal cual (postgresql://...). Usa el "Transaction pooler" (puerto 6543) en Vercel.
GENERAL_DATABASE_URL=postgresql+asyncpg://agecare:agecare@localhost:5433/agecare_general
GENERAL_JWT_SECRET=cambia-esto-en-produccion
GENERAL_ENVIRONMENT=dev
# URL pública de la API de administración + clave compartida (mismo valor que ADMIN_INTERNAL_SYNC_KEY)
GENERAL_ADMIN_SYNC_URL=http://host.docker.internal:8000/api/v1/admin
GENERAL_ADMIN_SYNC_KEY=clave-interna-solo-para-desarrollo
# Supabase Storage (fotos y documentos). Vacío = carpeta local uploads/
GENERAL_SUPABASE_URL=
GENERAL_SUPABASE_SERVICE_KEY=
GENERAL_STORAGE_BUCKET=agecare-uploads
# Dominios de los frontends permitidos por CORS, separados por coma
CORS_ORIGINS=
